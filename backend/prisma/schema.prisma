generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  comments Comment[]
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String    @db.Text
  coverImageUrl String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  categories    PostCategory[]
}

model Category {
  id    String         @id @default(uuid())
  name  String         @unique
  slug  String         @unique
  posts PostCategory[]
  artifacts ArtifactCategory[]
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model Artifact {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String            @db.Text
  imageUrl    String?
  fileUrl     String?
  published   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  categories  ArtifactCategory[]
}

model ArtifactCategory {
  artifactId   String
  categoryId   String
  artifact     Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([artifactId, categoryId])
}


model User {
  id       String @id @default(uuid())
  username String @unique
  password String
  createdAt DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  author    String
  content   String   @db.Text
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())
}

// --- Interactive Stories (Phase 9A) -----------------------------------------
//
// A Story is a graph of nodes. Each node holds a passage of narrative text;
// each StoryChoice links a source node to a destination node within the SAME
// story. The composite foreign keys below are what make "a choice can never
// lead into another story" a database-level guarantee rather than an
// application convention:
//
//   StoryChoice.(nodeId, storyId)            -> StoryNode.(id, storyId)
//   StoryChoice.(destinationNodeId, storyId) -> StoryNode.(id, storyId)
//   Story.(startingNodeId, id)               -> StoryNode.(id, storyId)
//
// Every one of those composite keys carries the story id, so a mismatched
// story id is rejected by PostgreSQL itself. StoryNode exposes
// @@unique([id, storyId]) purely as the target those composite keys need.

model Story {
  // Story.id takes part in the composite foreign key that ties the starting
  // node to this story, and Prisma cannot apply a client-side @default(uuid())
  // to a field that belongs to a relation's `fields` array (it would send
  // NULL and violate the primary key). The default is therefore generated by
  // PostgreSQL itself.
  id             String        @id @default(dbgenerated("gen_random_uuid()"))
  title          String
  slug           String        @unique
  introduction   String        @db.Text
  published      Boolean       @default(false)
  publishedAt    DateTime?
  startingNodeId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  nodes          StoryNode[]
  choices        StoryChoice[]

  startingNode StoryNode? @relation("StoryStartingNode", fields: [startingNodeId, id], references: [id, storyId], onDelete: NoAction)
}

model StoryNode {
  id              String        @id @default(uuid())
  storyId         String
  title           String?
  content         String        @db.Text
  isEnding        Boolean       @default(false)
  published       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  story           Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  outgoingChoices StoryChoice[] @relation("ChoiceSource")
  incomingChoices StoryChoice[] @relation("ChoiceDestination")
  startingFor     Story[]       @relation("StoryStartingNode")

  // Required as the target of the composite foreign keys above.
  @@unique([id, storyId])
  @@index([storyId])
}

model StoryChoice {
  id                String    @id @default(uuid())
  storyId           String
  nodeId            String
  destinationNodeId String
  label             String
  published         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  story             Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sourceNode        StoryNode @relation("ChoiceSource", fields: [nodeId, storyId], references: [id, storyId], onDelete: Cascade)
  destinationNode   StoryNode @relation("ChoiceDestination", fields: [destinationNodeId, storyId], references: [id, storyId], onDelete: NoAction)

  @@index([storyId])
  @@index([nodeId])
  @@index([destinationNodeId])
}
