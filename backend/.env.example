PORT=3000
NODE_ENV=development

# The origins allowed to make credentialed requests to the API. A
# comma-separated list of exact origins, e.g.
#
#   FRONTEND_ORIGIN="https://example.com,https://www.example.com"
#
# The wildcard "*" is NOT accepted together with credentials: the browser
# refuses that combination, and it would expose the API to every origin.
# When this is empty the API is same-origin only, which is the correct
# default when one host serves both the site and the API.
FRONTEND_ORIGIN="http://localhost:5500"

# ---------------------------------------------------------------------------
# Reverse proxy
#
# The number of trusted proxies in front of the API. This decides how the
# client's IP address is determined, and therefore whose bucket a rate
# limited request counts against.
#
#   TRUST_PROXY_HOPS=0   the API is exposed directly (the default)
#   TRUST_PROXY_HOPS=1   one reverse proxy in front (the usual deployment)
#   TRUST_PROXY_HOPS=2   a CDN in front of a reverse proxy
#
# Behind a proxy with this left at 0, every visitor shares ONE rate-limit
# bucket, and the first few arrivals lock everybody else out of commenting,
# logging in and sending inquiries.
#
# It is never set to "true": that would let any client spoof its own IP
# through the X-Forwarded-For header and escape the rate limit. A value
# outside 0-10 stops the process at startup.
# ---------------------------------------------------------------------------
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Secrets
#
# Every value below is a PLACEHOLDER. Replace each one with a random value
# before running anything other than a local development instance.
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# The production process refuses to start when JWT_SECRET or CSRF_SECRET is
# missing, so a half-configured deployment fails immediately rather than
# running with a guessable secret.
# ---------------------------------------------------------------------------
JWT_SECRET=replace-me-with-a-random-value
CSRF_SECRET=replace-me-with-a-random-value

# The issuer and audience bind an administrator token to this application.
# A token minted for another service is rejected even if it carries the
# right secret.
JWT_ISSUER=wdc-api
JWT_AUDIENCE=wdc-admin

# How long an administrator session lasts.
JWT_EXPIRES_IN=2h

# ---------------------------------------------------------------------------
# Database configuration
# ---------------------------------------------------------------------------
# IMPORTANT - read before changing anything here.
#
# Two PostgreSQL servers listen on port 5432 on this machine:
#
#   1. A native Windows service, "postgresql-x64-16" (PostgreSQL 16.15,
#      compiled by Visual C++). It is NOT published through Docker.
#   2. A Docker container named "wednesdays-db" (postgres:16-alpine), which
#      maps 0.0.0.0:5432 -> 5432 as well.
#
# When both bind the same port, "localhost:5432" resolves to the NATIVE
# Windows service, because it owns the IPv6 loopback (::1) that
# "localhost" resolves to first. Verified with backend/scripts/pg-topology.js.
#
# The databases that actually hold this project's data live on the NATIVE
# service:
#
#   wednesdays_dark_chronicles  - development / production data (role: postgres)
#   db_test                     - the dedicated test database    (role: user)
#
# The Docker container's "wednesdays_dark_chronicles" database is EMPTY
# (0 tables in the public schema). Pointing the application at it would
# mean starting from an empty database and losing the seeded content, so
# the Docker container is currently NOT the active database for this
# project. It is left running and untouched.
#
# The docker-compose.yml file in the project root provisions the container
# for environments where it is the only PostgreSQL instance (for example
# CI or a fresh checkout on a machine without the Windows service). On such
# a machine the same DATABASE_URL works, because there is nothing else
# listening on 5432.
#
# To force the Docker container explicitly, use the container IP or a
# different published port rather than "localhost".
# ---------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=replace-me-with-the-database-password
DB_NAME=wednesdays_dark_chronicles
DB_PORT=5432

# Prisma connection string
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public"

# ---------------------------------------------------------------------------
# Test database
# ---------------------------------------------------------------------------
# The automated suite NEVER uses DATABASE_URL above. When NODE_ENV=test the
# backend loads .env.test instead, and src/lib/test-env.js refuses to run if
# that file is missing or resolves to the same database name as DATABASE_URL
# above. Keep db_test on a separate database AND a separate role.
#
#   cp .env.example .env.test  (then adjust the values)
#
# .env.test must define: DATABASE_URL, JWT_SECRET, CSRF_SECRET
# ---------------------------------------------------------------------------
